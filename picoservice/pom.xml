<?xml version="1.0" encoding="UTF-8"?>
<project xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns="http://maven.apache.org/POM/4.0.0"
    xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>de.adito.picoservice</groupId>
    <artifactId>picoservice-parent</artifactId>
    <version>${revision}</version>
  </parent>

  <artifactId>picoservice</artifactId>
  <name>${project.groupId}:${project.artifactId}</name>
  <description>Compatibility artifact containing the Picoservice runtime library and annotation processor</description>

  <dependencies>
    <dependency>
      <groupId>de.adito.picoservice</groupId>
      <artifactId>picoservice-core</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>de.adito.picoservice</groupId>
      <artifactId>picoservice-processor</artifactId>
      <version>${project.version}</version>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.codehaus.mojo</groupId>
        <artifactId>flatten-maven-plugin</artifactId>
        <configuration>
          <!-- we want to publish the compatibility artifact with actual contents and not only as a reference (maven central requirement) -->
          <flattenMode>ossrh</flattenMode>
          <pomElements>
            <dependencies>remove</dependencies>
          </pomElements>
        </configuration>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-jar-plugin</artifactId>
        <configuration>
          <forceCreation>true</forceCreation>
        </configuration>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-javadoc-plugin</artifactId>
        <configuration>
          <!-- The compatibility JAR is assembled from these dependencies and has no own sources. -->
          <includeDependencySources>true</includeDependencySources>
          <!-- jsr305 is provided by picoservice-core and therefore is not transitive here. -->
          <additionalDependencies>
            <additionalDependency>
              <groupId>com.google.code.findbugs</groupId>
              <artifactId>jsr305</artifactId>
              <version>${jsr305.version}</version>
            </additionalDependency>
          </additionalDependencies>
        </configuration>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-shade-plugin</artifactId>
        <executions>
          <execution>
            <phase>package</phase>
            <goals>
              <goal>shade</goal>
            </goals>
            <configuration>
              <createDependencyReducedPom>false</createDependencyReducedPom>
              <!-- Attach the sources of the classes included in the compatibility JAR. -->
              <createSourcesJar>true</createSourcesJar>
              <filters>
                <filter>
                  <artifact>de.adito.picoservice:*</artifact>
                  <excludes>
                    <exclude>META-INF/MANIFEST.MF</exclude>
                  </excludes>
                </filter>
              </filters>
              <transformers>
                <transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer"/>
                <transformer implementation="org.apache.maven.plugins.shade.resource.ServicesResourceTransformer"/>
              </transformers>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
